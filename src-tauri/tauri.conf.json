{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/master/core/tauri-config-schema/schema.json",
  "productName": "The Digital Atrium",
  "version": "1.6.9",
  "identifier": "com.digitalatrium.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "The Digital Atrium",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob: asset: http://asset.localhost; media-src 'self' https: http: data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; frame-src https: http:; connect-src 'self' https: wss: blob: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Digital Atrium",
    "copyright": "Digital Atrium",
    "shortDescription": "A collaborative infinite canvas",
    "longDescription": "The Digital Atrium is a collaborative infinite canvas for collecting, arranging and sharing whatever you're thinking about -- images, text, embeds and documents, laid out in space rather than in a list.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/installer-header.bmp",
        "sidebarImage": "installer/installer-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:atrium.db"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QkI5Q0Y0RTY0RUNFMzkKUldRNXprN205Snk3aWNQend6c1R0TXR0aXQyOWYzWkpFZzFzZFhmRXpzR0lnYXpJMGwweDlXcGIK",
      "endpoints": [
        "https://github.com/Ednyan/The-Atrium/releases/latest/download/latest.json"
      ]
    }
  }
}
