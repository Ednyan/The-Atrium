# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri build artifacts
src-tauri/target/

# Environment variables
.env
.env.local
.env.production

# Supabase CLI local link state (project ref/version cache, no secrets, but not project source)
supabase/.temp/

# Unused per-weight static font files from Google-Fonts-style family folders.
# The build (import.meta.glob in TraceOverlay.tsx) only uses each family's
# root variable/Regular font; the static/ weights are hundreds of MB and are
# excluded from the bundle, so they must not bloat the repo. Local copies stay.
src/assets/fonts/**/static/

# Blender's autosave copy of the previous save. Not a source file, and it
# reappears every time the logo is opened and saved.
*.blend1

# Updater signing keys -- the private key must never be committed. Losing it
# means never being able to sign an update existing installs will accept.
*.key
*.key.pub

# Generated per-release by scripts/make-release-manifest.mjs; uploaded to the
# GitHub release rather than committed.
latest.json

# pdfjs runtime assets, copied from node_modules at build time
public/pdfjs/
build-extension/
